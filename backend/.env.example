APP_NAME="Nebula9 Enterprise Knowledge Intelligence"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Security & Secrets (PRD Section 7.2)
SECRET_KEY="nebula9-insecure-dev-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database (SQLite default for local development, easily swappable with PostgreSQL)
DATABASE_URL="sqlite:///./nebula9_reference.db"

# Active Industry Configuration Path
CONFIG_DIR="../config/industries"
DEFAULT_INDUSTRY="manufacturing"
